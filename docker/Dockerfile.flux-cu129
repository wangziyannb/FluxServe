ARG CUDA_VERSION=12.9.1
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu22.04 AS dependencies
# Public paged/ragged block-extend + FP8 FA2 + CUTLASS NVFP4 MoE APIs.
ARG FLASHINFER_DLLM_REV=5ce4d077c33bbe167386cf5487a4a5bb4bcafbfd

LABEL org.opencontainers.image.authors="Youpeng Zhao" \
      org.opencontainers.image.description="FluxServe image with CUDA 12.9 userspace"

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=America/New_York \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST="9.0;10.0a;12.0" \
    MAX_JOBS=4 \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64

RUN set -eux; \
    ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime; \
    echo "${TZ}" > /etc/timezone; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        software-properties-common \
        wget; \
    add-apt-repository ppa:deadsnakes/ppa -y; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        python3.12-full \
        python3.12-dev \
        python3.10-venv; \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1; \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 2; \
    update-alternatives --set python3 /usr/bin/python3.12; \
    ln -sf /usr/bin/python3.12 /usr/bin/python; \
    wget https://bootstrap.pypa.io/get-pip.py; \
    python3 get-pip.py; \
    rm -f get-pip.py; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    mkdir -p /flashinfer-dllm-workspace; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bear \
        build-essential \
        ccache \
        check \
        cloc \
        cmake \
        curl \
        debhelper \
        devscripts \
        dkms \
        dnsutils \
        fakeroot \
        gdb \
        git \
        git-lfs \
        htop \
        ibverbs-providers \
        infiniband-diags \
        kmod \
        less \
        libboost-all-dev \
        libcurl4-openssl-dev \
        libczmq-dev \
        libczmq4 \
        libfabric-dev \
        libgoogle-glog-dev \
        libgrpc++-dev \
        libgrpc-dev \
        libgtest-dev \
        libhiredis-dev \
        libibumad3 \
        libibverbs-dev \
        libibverbs1 \
        libjsoncpp-dev \
        libnl-3-200 \
        libnl-3-dev \
        libnl-route-3-200 \
        libnl-route-3-dev \
        libnuma-dev \
        libnuma1 \
        libopenmpi-dev \
        librdmacm1 \
        libssl-dev \
        libsubunit-dev \
        libsubunit0 \
        libunwind-dev \
        locales \
        lsof \
        netcat-openbsd \
        ninja-build \
        nvtop \
        openssh-server \
        patchelf \
        perftest \
        pkg-config \
        protobuf-compiler \
        protobuf-compiler-grpc \
        pybind11-dev \
        rdma-core \
        rsync \
        silversearcher-ag \
        tmux \
        tree \
        unzip \
        vim \
        wget \
        zsh; \
    rm -rf /var/lib/apt/lists/*; \
    apt-get clean

RUN set -eux; \
    python -m pip install --upgrade \
        pip==26.1.2 \
        setuptools==83.0.0 \
        wheel==0.47.0; \
    python -m pip install \
        torch==2.8.0 \
        torchvision==0.23.0 \
        torchaudio==2.8.0 \
        --index-url https://download.pytorch.org/whl/cu129

RUN set -eux; \
    python -m pip install \
        triton==3.4.0 \
        transformers==5.15.1 \
        tokenizers==0.22.1 \
        safetensors==0.8.0 \
        huggingface-hub==1.28.0 \
        numpy==2.3.3 \
        einops==0.8.2 \
        aiohttp==3.13.0 \
        fastapi==0.118.2 \
        uvicorn==0.37.0 \
        pyzmq==27.1.0 \
        packaging==25.0 \
        setproctitle==1.3.7 \
        scikit-build-core==0.11.6 \
        "nanobind>=1.7.0" \
        ninja==1.13.0 \
        nvidia-ml-py==13.580.82 \
        apache-tvm-ffi==0.1.12 \
        nvidia-cutlass-dsl==4.7.0 \
        cuda-python==12.9.7 \
        sgl-kernel==0.3.15; \
    python -m pip uninstall -y pynvml || true; \
    python -m pip uninstall -y flashinfer-python || true

COPY docker/check_flashinfer.py /opt/fluxserve/docker/check_flashinfer.py
RUN set -eux; \
    git clone https://github.com/FLX-OSS/flashinfer-dllm \
        -b dllm/block-decode \
        /flashinfer-dllm-workspace/flashinfer-dllm; \
    cd /flashinfer-dllm-workspace/flashinfer-dllm; \
    git checkout --detach "${FLASHINFER_DLLM_REV}"; \
    git submodule update --init --recursive 3rdparty/cutlass 3rdparty/spdlog 3rdparty/cccl; \
    python -m pip freeze > /tmp/fluxserve-runtime-constraints.txt; \
    BUILD_NVEP=0 FLASHINFER_BUILD_NO_PIP=1 python -m pip install -v \
        --no-build-isolation -c /tmp/fluxserve-runtime-constraints.txt .; \
    # apt tools use Debian version strings that pip cannot validate. Check the
    # pip-managed runtime without the separate distro Python package directory.
    python -c 'import sys; sys.path = [p for p in sys.path if p != "/usr/lib/python3/dist-packages"]; from pip._internal.cli.main import main; sys.exit(main(["check"]))'; \
    python /opt/fluxserve/docker/check_flashinfer.py --expected-revision "${FLASHINFER_DLLM_REV}"; \
    rm /tmp/fluxserve-runtime-constraints.txt; \
    rm -rf /root/.cache/pip

# The dependencies target remains available for development. The default target
# installs the repository and builds native libraries without needing a GPU.
FROM dependencies AS runtime
ARG FLUX_KERNEL_CUDA_ARCH="90a;100a;120"
ENV FLUX_KERNEL_CUDA_ARCH=${FLUX_KERNEL_CUDA_ARCH} \
    FLUXSERVE_FLASHINFER_REV=${FLASHINFER_DLLM_REV} \
    FLUXSERVE_CACHE_DIR=/var/cache/fluxserve \
    PYTHONUNBUFFERED=1 \
    TOKENIZERS_PARALLELISM=false

WORKDIR /opt/fluxserve
COPY flux-kernel/python ./flux-kernel/python
RUN set -eux; \
    FLUX_KERNEL_SKIP_CUDA_BUILD=1 python -m pip install --no-deps --no-build-isolation ./flux-kernel/python; \
    python -m flux_kernel.precompile; \
    python -m flux_kernel.precompile --check

COPY flux-scheduler ./flux-scheduler
RUN python -m pip install --no-deps --no-build-isolation ./flux-scheduler

COPY setup.py ./
COPY python ./python
COPY docker ./docker
RUN set -eux; \
    python -m pip install --no-deps --no-build-isolation .; \
    python -m flux_kernel.precompile --check --output /opt/fluxserve/build-info.json; \
    python /opt/fluxserve/docker/precompile_tvm_ffi.py; \
    python /opt/fluxserve/docker/check_flashinfer.py \
        --expected-revision "${FLASHINFER_DLLM_REV}" --manifest /opt/fluxserve/build-info.json; \
    python -c "import fluxserve, flux_scheduler; from flux_kernel.ops import quantize_scatter_kv"; \
    chmod -R a+rX /opt/fluxserve; \
    mkdir -p /var/cache/fluxserve /calibration /datasets /models; \
    chmod 1777 /var/cache/fluxserve; \
    rm -rf /root/.cache/pip

# Fail early on an incompatible/missing native binary instead of compiling into
# read-only site-packages. Triton/FlashInfer JIT caches remain writable.
ENV FLUX_KERNEL_REQUIRE_PREBUILT=1
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=30m --retries=3 \
    CMD python /opt/fluxserve/docker/healthcheck.py
ENTRYPOINT ["python", "/opt/fluxserve/docker/entrypoint.py"]
CMD ["--help"]
